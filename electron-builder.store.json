{
  "$comment": "Microsoft Store build (MSIX/AppX). Identity values come from Partner Center \u2192 Media Forge Video Converter \u2192 Product identity. Run `npm run store` on Windows, or let GitHub Actions do it.",
  "appId": "com.mediaforge.app",
  "productName": "Media Forge",
  "copyright": "Copyright \u00a9 2026 Media Forge",
  "directories": {
    "output": "dist-store",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "vendor/ffmpeg",
      "to": "ffmpeg",
      "filter": [
        "**/*"
      ]
    }
  ],
  "afterPack": "scripts/after-pack.js",
  "electronLanguages": [
    "en-US"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "appx",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "MediaForge-Store-${version}-x64.${ext}",
    "signAndEditExecutable": false,
    "fileAssociations": [
      {
        "ext": "mkv",
        "name": "Matroska Video"
      },
      {
        "ext": "mp4",
        "name": "MP4 Video"
      },
      {
        "ext": "m4v",
        "name": "MP4 Video"
      },
      {
        "ext": "avi",
        "name": "AVI Video"
      },
      {
        "ext": "mpg",
        "name": "MPEG Video"
      },
      {
        "ext": "mpeg",
        "name": "MPEG Video"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video"
      },
      {
        "ext": "wmv",
        "name": "Windows Media Video"
      },
      {
        "ext": "ts",
        "name": "MPEG Transport Stream"
      },
      {
        "ext": "m2ts",
        "name": "MPEG Transport Stream"
      },
      {
        "ext": "webm",
        "name": "WebM Video"
      },
      {
        "ext": "flv",
        "name": "Flash Video"
      },
      {
        "ext": "vob",
        "name": "DVD Video"
      }
    ]
  },
  "appx": {
    "identityName": "SenseiLemon.MediaForgeVideoConverter",
    "publisher": "CN=CACA4A31-C5CF-4665-B37E-CCDB161106EE",
    "publisherDisplayName": "Sensei Lemon",
    "applicationId": "MediaForge",
    "displayName": "Media Forge Video Converter",
    "backgroundColor": "#07101f",
    "languages": [
      "en-US"
    ],
    "showNameOnTiles": true,
    "setBuildNumber": false,
    "addAutoLaunchExtension": false
  }
}
